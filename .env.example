# Same values your WhatsApp bot already uses to reach the agent
AGENTIC_API_URL=https://your-agentic-service.onrender.com
INTERNAL_SERVICE_TOKEN=replace-with-the-same-private-token-used-by-agentic
# Optional
PORT=3002
# Password for the dashboard. Leave empty to run locally only (127.0.0.1).
DASHBOARD_TOKEN=
# The id Agentic sees in place of a WhatsApp phone number
DASHBOARD_MERCHANT_ID=dashboard
# Recommended on Render. State survives redeploys when this is configured.
DATABASE_URL=
# Set false only when your PostgreSQL provider does not require TLS.
DATABASE_SSL=true
# Optional: expiry scan frequency. Defaults to once every 24 hours.
INVENTORY_SCAN_INTERVAL_MS=86400000